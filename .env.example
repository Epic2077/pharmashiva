# ──────────────────────────────────────────────────────────────
# Supabase (SiteHarvest database)
# Fill these in from your Supabase dashboard:
#   Project Settings → API  (URL + keys)
#   Account → Access Tokens (personal access token)
# ──────────────────────────────────────────────────────────────

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key — server-side reads/writes (bypasses RLS).
# Used by the data layer in lib/supabase and the /api routes.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token — only used by `db:init` (Management API).
SUPABASE_ACCESS_TOKEN=

# Anon/publishable key — only needed if you later add a browser client.
SUPABASE_ANON_KEY=

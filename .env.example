# ──────────────────────────────────────────────────────────────
# Supabase (SiteHarvest database)
# Fill these in from your Supabase dashboard:
#   Project Settings → API  (URL + keys)
#   Account → Access Tokens (personal access token)
# ──────────────────────────────────────────────────────────────

# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Service-role key — server-side reads/writes (bypasses RLS).
# Used by the data layer in lib/supabase and the /api routes.
SUPABASE_SERVICE_ROLE_KEY=

# Personal access token — only used by `db:init` (Management API).
SUPABASE_ACCESS_TOKEN=

# Anon/publishable key — used by the server-side auth client (@supabase/ssr).
# It is never shipped to the browser: auth runs through server actions.
SUPABASE_ANON_KEY=

# Auth: add this to Supabase → Authentication → URL Configuration → Redirect URLs:
#   http://localhost:3000/auth/callback

# ──────────────────────────────────────────────────────────────
# DeepSeek (AI chat pipeline)
# Server-only. Never expose this key to client code.
# Get a key from https://platform.deepseek.com/api_keys
# ──────────────────────────────────────────────────────────────

# Required for AI responses. Without it, the chat still returns
# deterministic safety results and real catalog products.
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown).
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Deeper model used when the composer's "Think" toggle is on.
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# DEEPSEEK_INTERPRET_MODEL=deepseek-flash
# Thinking effort for answers: low | high | max (default low).
# DEEPSEEK_REASONING_EFFORT=low
# Thinking effort for the Pro model (default high).
# DEEPSEEK_PRO_REASONING_EFFORT=high
# DEEPSEEK_INTERPRET_TIMEOUT_MS=7000
# DEEPSEEK_RESPONSE_TIMEOUT_MS=25000
